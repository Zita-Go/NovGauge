# Copy to .env, edit, then export: set -a; source .env; set +a
NOVGAUGE_BASE_URL=https://your-provider.example/v1
NOVGAUGE_API_KEY=replace-with-your-key
EVAL_MODEL=your-evaluation-model
JUDGE_MODEL=your-judge-model
CONTENT_MODE=full

# Optional separate judge endpoint and key:
# JUDGE_BASE_URL=https://your-judge-provider.example/v1
# JUDGE_API_KEY=replace-with-your-judge-key

# Optional input and output paths:
# POS_INPUT=data/positives.json
# NEG_INPUT=data/negatives.json
# INPUT=data/grouping.json
# RUN_DIR=results/my-run
