# Copy to .env and edit locally. Entry points use environment variables;
# explicitly export this file with: set -a; source .env; set +a
NOVGAUGE_BASE_URL=https://your-provider.example/v1
NOVGAUGE_API_KEY=replace-with-your-key

# Model identifiers must match your provider. Defaults in the original scripts
# are preserved; set these to the identifiers available on your endpoint.
EVAL_MODEL=your-evaluation-model
JUDGE_MODEL=your-judge-model
CONTENT_MODE=full

# Optional, independent judge credentials:
# JUDGE_BASE_URL=https://your-judge-provider.example/v1
# JUDGE_API_KEY=replace-with-your-judge-key

# Optional local paths for the shell entry points:
# POS_INPUT=data/positives.json
# NEG_INPUT=data/negatives.json
# INPUT=data/grouping.json
# RUN_DIR=results/my-run
